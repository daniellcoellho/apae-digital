# URL base usada pelo axios no browser. Deixe "/api" para passar pelo rewrite
# do Next (que encaminha para o BACKEND_URL). Em deploy sem rewrite, aponte
# para a URL publica do backend (ex.: https://api.seudominio.com/api).
NEXT_PUBLIC_API_BASE_URL=/api

# Tenant padrao (slug da APAE) quando nao for possivel resolver pelo dominio
NEXT_PUBLIC_DEFAULT_TENANT=apiuna

# URL do backend Spring Boot usada pelos rewrites do Next (/api e /uploads).
# Em dev: http://localhost:8080. Em HML/producao: a URL publica do backend.
BACKEND_URL=http://localhost:8080
